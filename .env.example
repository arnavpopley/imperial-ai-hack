ANTHROPIC_API_KEY=
# Model IDs are configuration, never hard-coded (spec section 5).
MODEL_SMART=claude-opus-5-5
MODEL_FAST=claude-sonnet-5-5
# Simple yes/no classifiers (scope, injection, wellbeing, intent) and short wording.
MODEL_LIGHT=claude-haiku-4-5
# Grader for npm run eval:live and the ranking benchmark; the strongest model, so it can judge the others.
MODEL_JUDGE=claude-fable-5-1
PORT=8790
DATABASE_PATH=./server/modulematch.db
