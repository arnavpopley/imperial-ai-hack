{
  "name": "modulematch",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "api",
    "web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w api\" \"npm run dev -w web\"",
    "build": "npm run build -w web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "seed": "npm run seed -w api",
    "eval": "npm run eval -w api"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "better-sqlite3@13.2.0": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
