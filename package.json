{
  "name": "modulematch",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "server",
    "web"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "seed": "npm run seed -w server",
    "eval": "npm run eval -w server",
    "build:vercel": "tsx scripts/build-vercel.ts",
    "deploy:vercel": "npm run build:vercel && npx vercel@latest deploy --prebuilt --prod",
    "eval:live": "npm run eval:live -w server",
    "benchmark": "npm run benchmark -w server --",
    "e2e": "node scripts/e2e/demo-journey.mjs",
    "demo:video": "node scripts/e2e/demo-journey.mjs --video"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  },
  "allowScripts": {
    "better-sqlite3@13.2.0": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents": false
  }
}
